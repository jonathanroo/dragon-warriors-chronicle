---
layout: layouts/base.njk
title: Souls and Miscreants
permalink: /souls/
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/section/section.njk" import section %}
{% from "components/card/card.njk" import card, cardGrid %}
{% set groups = [
  ["soul", "Souls", "Friends, helpers and the merely harmless"],
  ["miscreant", "Miscreants", "Rogues, villains and the deeply suspicious"]
] %}
{{ pageHeader({ kicker: "Folk met upon the road", title: title }) }}
{% for g in groups %}
{% set people = collections.souls | where("kind", g[0]) %}
{% call section({ title: g[1], id: g[0] + "-h", intro: g[2], wide: true }) %}
  {% if people.length %}
  {% call cardGrid() %}
    {% for p in people %}
    {{ card({ title: p.data.title, href: p.url, sub: p.data.role + (", deceased" if p.data.status == "dead" else ""), body: p.data.summary, muted: p.data.status == "dead" }) }}
    {% endfor %}
  {% endcall %}
  {% else %}
  <p>None yet.</p>
  {% endif %}
{% endcall %}
{% endfor %}
