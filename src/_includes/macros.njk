{#- Comma separated links to items in a collection, by slug -#}
{% macro links(collection, slugs) -%}
{%- for slug in slugs -%}
  {%- set item = collection | bySlug(slug) -%}
  {%- if item %}<a href="{{ item.url }}">{{ item.data.title }}</a>{% else %}{{ slug }}{% endif %}
  {%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{%- endmacro %}

{#- A list of sessions as entry links -#}
{% macro sessionList(sessions) %}
<ol class="session-list">
  {%- for s in sessions %}
  <li><span class="num">{{ s.data.session | roman }}</span><a href="{{ s.url }}">{{ s.data.title }}</a></li>
  {%- endfor %}
</ol>
{% endmacro %}

{% macro statusMark(status) %}
{% if status == "dead" %}<span class="mark mark-dead">Fallen</span>
{% elif status == "missing" or status == "unknown" %}<span class="mark">Whereabouts unknown</span>
{% endif %}
{% endmacro %}
