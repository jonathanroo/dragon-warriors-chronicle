{#-
  A big number with a label.
  tally({ value, label })     a single figure
  tallies([{ value, label }]) a row of figures
-#}
{% macro tally(p) -%}
<p class="tally"><span class="tally__value">{{ p.value }}</span> <span class="tally__label">{{ p.label }}</span></p>
{%- endmacro %}

{% macro tallies(items, label = "Tallies") %}
<ul class="tallies" aria-label="{{ label }}">
  {%- for t in items %}
  <li class="tally"><span class="tally__value">{{ t.value }}</span> <span class="tally__label">{{ t.label }}</span></li>
  {%- endfor %}
</ul>
{% endmacro %}
