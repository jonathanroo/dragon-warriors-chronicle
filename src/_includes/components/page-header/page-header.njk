{#-
  The centred heading block at the top of every page.
  p.kicker  small capitals line above the title (may contain HTML)
  p.title   the h1
  p.lede    italic standfirst
  p.status  alive | dead | missing
  p.meta    [{ label, value }] shown as a row of facts (value may contain HTML)
  Content passed with {% call %} goes after the meta.
-#}
{% from "components/status-mark/status-mark.njk" import statusMark %}
{% macro pageHeader(p) %}
<header class="page-header">
  {% if p.kicker %}<p class="page-header__kicker">{{ p.kicker | safe }}</p>{% endif %}
  <h1>{{ p.title }}</h1>
  {{ statusMark(p.status) }}
  {% if p.lede %}<p class="page-header__lede">{{ p.lede }}</p>{% endif %}
  {% set meta = p.meta | default([]) | selectattr("value") %}
  {% if meta | length %}
  <dl class="page-header__meta">
    {% for m in meta %}<div><dt>{{ m.label }}</dt><dd>{{ m.value | safe }}</dd></div>{% endfor %}
  </dl>
  {% endif %}
  {% if caller %}{{ caller() }}{% endif %}
</header>
{% endmacro %}
