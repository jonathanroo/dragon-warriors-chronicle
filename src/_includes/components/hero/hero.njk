{#-
  The home page opening. Extra content (such as tallies) goes in with {% call %}.
  p.kicker, p.title, p.lede
-#}
{% macro hero(p) %}
<section class="hero" aria-labelledby="hero-title">
  {% if p.kicker %}<p class="hero__kicker">{{ p.kicker }}</p>{% endif %}
  <h1 id="hero-title">{{ p.title }}</h1>
  {% if p.lede %}<p class="hero__lede">{{ p.lede }}</p>{% endif %}
  {% if caller %}{{ caller() }}{% endif %}
</section>
{% endmacro %}
