{#-
  Sessions in order of play.
  sessions   collection items with data.session, data.title
  p.variant  "compact" (default), numbered in Roman numerals, or "contents",
             centred chapter blocks with the date, place, summary and a link
-#}
{% macro sessionList(sessions, p = {}) %}
{% if p.variant == "contents" %}
<ol class="session-list session-list--contents">
  {%- for s in sessions %}
  <li>
    <p class="session-list__kicker">Entry the {{ s.data.session | ordinal }}</p>
    <h2 class="session-list__heading"><a class="session-list__title" href="{{ s.url }}">{{ s.data.title }}</a></h2>
    <p class="session-list__when">{{ s.data.date | readableDate }}{% if s.data.location %} · {{ s.data.location }}{% endif %}</p>
    {% if s.data.summary %}<p class="session-list__summary">{{ s.data.summary }}</p>{% endif %}
    <p class="session-list__more"><a href="{{ s.url }}" aria-hidden="true" tabindex="-1">Read the entry</a></p>
  </li>
  {%- endfor %}
</ol>
{% else %}
<ol class="session-list">
  {%- for s in sessions %}
  <li><span class="session-list__num">{{ s.data.session | roman }}</span><a href="{{ s.url }}">{{ s.data.title }}</a></li>
  {%- endfor %}
</ol>
{% endif %}
{% endmacro %}
