{#-
  Sessions numbered in Roman numerals.
  sessions   collection items with data.session, data.title
  p.variant  "compact" (default) or "contents", which adds date, place and summary
-#}
{% macro sessionList(sessions, p = {}) %}
{% if p.variant == "contents" %}
<ol class="session-list session-list--contents">
  {%- for s in sessions %}
  <li>
    <span class="session-list__num">{{ s.data.session | roman }}</span>
    <div>
      <a class="session-list__title" href="{{ s.url }}">{{ s.data.title }}</a>
      <span class="session-list__when">{{ s.data.date | readableDate }}{% if s.data.location %} · {{ s.data.location }}{% endif %}</span>
      {% if s.data.summary %}<p>{{ s.data.summary }}</p>{% endif %}
    </div>
  </li>
  {%- endfor %}
</ol>
{% else %}
<ol class="session-list">
  {%- for s in sessions %}
  <li><span class="session-list__num">{{ s.data.session | roman }}</span><a href="{{ s.url }}">{{ s.data.title }}</a></li>
  {%- endfor %}
</ol>
{% endif %}
{% endmacro %}
