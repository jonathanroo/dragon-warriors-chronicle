{#-
  A framed aside listing who and what appeared.
  {% call cast("Who and what appeared") %}
    {% call castGroup("Of the company") %}…links…{% endcall %}
  {% endcall %}
-#}
{% macro cast(label = "Who and what appeared") %}
<aside class="cast" aria-label="{{ label }}">
  {{ caller() }}
</aside>
{% endmacro %}

{% macro castGroup(label) %}
<p class="cast__group"><span class="cast__label">{{ label }}</span> {{ caller() }}</p>
{% endmacro %}
