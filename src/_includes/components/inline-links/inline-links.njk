{#-
  Comma separated links to items in a collection, looked up by file slug.
  Unknown slugs are shown as plain text.
-#}
{% macro inlineLinks(collection, slugs) -%}
{%- for slug in slugs -%}
  {%- set item = collection | bySlug(slug) -%}
  {%- if item %}<a href="{{ item.url }}">{{ item.data.title }}</a>{% else %}{{ slug }}{% endif %}
  {%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{%- endmacro %}
