{#-
  Site header: series strip, title over a red glow, subtitle and section navigation.
  p.site        site data (title, titleLines, subtitle, tagline, nav)
  p.currentUrl  page.url, to mark the current section
  p.compact     true for a slim bar with just the title and nav
-#}
{% macro masthead(p) %}
{%- set title -%}
<span class="masthead__title">
  {%- if p.site.titleLines %}
  <span>{{ p.site.titleLines[0] }}</span> <small>{{ p.site.titleLines[1] }}</small> <span>{{ p.site.titleLines[2] }}</span>
  {%- else %}{{ p.site.title }}{% endif -%}
</span>
{%- endset -%}
{%- set nav -%}
<nav class="masthead__nav" aria-label="Sections">
  <ul>
    {%- for item in p.site.nav %}
    {%- set here = p.currentUrl and p.currentUrl.startsWith(item.url) %}
    <li><a href="{{ item.url }}"{% if here %} aria-current="{{ 'page' if p.currentUrl == item.url else 'true' }}"{% endif %}>{{ item.label }}</a></li>
    {%- endfor %}
  </ul>
</nav>
{%- endset -%}
{% if p.compact %}
<header class="masthead masthead--compact">
  <div class="masthead__glow">
    <div class="masthead__inner">
      <a href="/" class="masthead__brand">{{ title | safe }}</a>
      {{ nav | safe }}
    </div>
  </div>
</header>
{% else %}
<header class="masthead">
  {% if p.site.tagline %}<p class="masthead__strip">{{ p.site.tagline }}</p>{% endif %}
  <div class="masthead__glow">
    <a href="/" class="masthead__brand">
      {{ title | safe }}
      <span class="masthead__sub">{{ p.site.subtitle }}</span>
    </a>
  </div>
  {{ nav | safe }}
</header>
{% endif %}
{% endmacro %}
