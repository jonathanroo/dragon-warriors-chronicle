{%- from "components/skip-link/skip-link.njk" import skipLink -%}
{%- from "components/masthead/masthead.njk" import masthead -%}
{%- from "components/colophon/colophon.njk" import colophon -%}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title if (title and page.url != "/") else site.title %}
  {%- set pageDesc = summary or epithet or site.description %}
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if session else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/img/share.jpg">
  <meta property="og:image:secure_url" content="{{ site.url }}/img/share.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.title }}: a shield emblem and the title in uncial lettering on parchment">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ece0c2">
  <link rel="preload" href="/fonts/uncial-antiqua-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/emblem.svg" type="image/svg+xml">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {{ skipLink() }}
  {{ masthead({ site: site, currentUrl: page.url }) }}
  <main id="main" class="page">
    {{ content | safe }}
  </main>
  {{ colophon({ site: site }) }}
</body>
</html>
