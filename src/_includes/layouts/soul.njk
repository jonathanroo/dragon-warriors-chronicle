---
layout: layouts/base.njk
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/prose/prose.njk" import prose %}
{% from "components/portrait/portrait.njk" import portrait as portraitFigure %}
{% from "components/section/section.njk" import section %}
{% from "components/session-list/session-list.njk" import sessionList %}
{% set met = collections.sessions | mentioning("souls", page.fileSlug) %}
{% set firstMet %}{% if met.length %}<a href="{{ met[0].url }}">{{ met[0].data.title }}</a>{% endif %}{% endset %}
<article>
  {{ pageHeader({
    kicker: ("Miscreant" if kind == "miscreant" else "Soul") + ((' <span aria-hidden="true">·</span> ' + role) if role else ""),
    title: title,
    status: status,
    lede: summary,
    meta: [
      { label: "Found at", value: location },
      { label: "First met", value: firstMet | trim },
      { label: "The company's opinion", value: opinion }
    ]
  }) }}

  {{ portraitFigure({ src: portrait, alt: portraitAlt or ("Portrait of " + title) }) }}

  {% call prose({ dropcap: true }) %}{{ content | safe }}{% endcall %}

  {% if met.length %}
  {% call section({ title: "Appears in the Chronicle", id: "met-h" }) %}{{ sessionList(met) }}{% endcall %}
  {% endif %}
</article>
