---
layout: layouts/base.njk
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/portrait/portrait.njk" import portrait as portraitFigure %}
{% from "components/prose/prose.njk" import prose %}
{% from "components/section/section.njk" import section %}
{% from "components/session-list/session-list.njk" import sessionList %}
{% set appearances = collections.sessions | mentioning("company", page.fileSlug) %}
{% set kills = collections.sessions | kills("by", page.fileSlug) %}
<article>
  {{ pageHeader({
    kicker: profession + ((' <span aria-hidden="true">·</span> played by ' + player) if player else ""),
    title: title,
    status: status,
    lede: epithet
  }) }}

  {{ portraitFigure({ src: portrait, alt: portraitAlt or ("Portrait of " + title) }) }}

  {% call prose({ dropcap: true }) %}{{ content | safe }}{% endcall %}

  {% if kills.length %}
  {% call section({ title: "Slain by this hand", id: "kills-h", count: kills | total }) %}
    <ul class="plain-list">
      {%- for k in kills %}
      {% set c = collections.bestiary | bySlug(k.creature) %}
      <li>{{ k.count }} × {% if c %}<a href="{{ c.url }}">{{ c.data.title }}</a>{% else %}{{ k.creature }}{% endif %}, in <a href="{{ k.session.url }}">{{ k.session.data.title }}</a></li>
      {%- endfor %}
    </ul>
  {% endcall %}
  {% endif %}

  {% if appearances.length %}
  {% call section({ title: "Appears in the Chronicle", id: "app-h" }) %}{{ sessionList(appearances) }}{% endcall %}
  {% endif %}
</article>
