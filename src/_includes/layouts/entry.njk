---
layout: layouts/base.njk
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/prose/prose.njk" import prose %}
{% from "components/section/section.njk" import section %}
{% from "components/ledger/ledger.njk" import ledger %}
{% from "components/quote/quote.njk" import quote %}
{% from "components/cast/cast.njk" import cast, castGroup %}
{% from "components/inline-links/inline-links.njk" import inlineLinks %}
{% from "components/pager/pager.njk" import pager %}
{% set scribeItem = collections.company | bySlug(scribe) if scribe %}
{% set when %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endset %}
{% set scribeLink %}{% if scribeItem %}<a href="{{ scribeItem.url }}">{{ scribeItem.data.title }}</a>{% endif %}{% endset %}
<article>
  {{ pageHeader({
    kicker: "Entry the " + (session | ordinal) + '<span aria-hidden="true"> · </span>' + when,
    title: title,
    meta: [
      { label: "Where", value: location },
      { label: "Days passed", value: days },
      { label: "As told by", value: scribeLink | trim }
    ]
  }) }}

  {% call prose({ dropcap: true }) %}{{ content | safe }}{% endcall %}

  {% if slain and slain.length %}
  {% call section({ title: "The Tally of the Slain", id: "tally-h" }) %}
    {% call ledger({ caption: "Creatures slain this session", hideCaption: true, head: [{ text: "Creature" }, { text: "Struck down by" }, { text: "Number", numeric: true }] }) %}
      {%- for k in slain %}
      {% set c = collections.bestiary | bySlug(k.creature) %}
      {% set who = collections.company | bySlug(k.by) %}
      <tr>
        <td>{% if c %}<a href="{{ c.url }}">{{ c.data.title }}</a>{% else %}{{ k.creature }}{% endif %}</td>
        <td>{% if who %}<a href="{{ who.url }}">{{ who.data.title }}</a>{% else %}{{ k.by or "The company" }}{% endif %}</td>
        <td class="ledger__num">{{ k.count or 1 }}</td>
      </tr>
      {%- endfor %}
    {% endcall %}
  {% endcall %}
  {% endif %}

  {% if quotes and quotes.length %}
  {% call section({ title: "Overheard at the Table", id: "quotes-h" }) %}
    {% for q in quotes %}{{ quote({ text: q.text, cite: q.who }) }}{% endfor %}
  {% endcall %}
  {% endif %}

  {% call cast() %}
    {% if company and company.length %}{% call castGroup("Of the company") %}{{ inlineLinks(collections.company, company) }}{% endcall %}{% endif %}
    {% if souls and souls.length %}{% call castGroup("Characters") %}{{ inlineLinks(collections.souls, souls) }}{% endcall %}{% endif %}
    {% if encountered and encountered.length %}{% call castGroup("Creatures met") %}{{ inlineLinks(collections.bestiary, encountered) }}{% endcall %}{% endif %}
  {% endcall %}

  {% set prev = collections.sessions | getPreviousCollectionItem %}
  {% set next = collections.sessions | getNextCollectionItem %}
  {{ pager({
    prev: { url: prev.url, title: prev.data.title } if prev,
    next: { url: next.url, title: next.data.title } if next
  }) }}
</article>
