---
layout: layouts/base.njk
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/prose/prose.njk" import prose %}
{% from "components/section/section.njk" import section %}
{% from "components/session-list/session-list.njk" import sessionList %}
{% from "components/tally/tally.njk" import tally %}
{% set seen = collections.sessions | mentioning("encountered", page.fileSlug) %}
{% set kills = collections.sessions | kills("creature", page.fileSlug) %}
<article>
  {% call pageHeader({
    kicker: (kind or "Creature") + ((' <span aria-hidden="true">·</span> ' + habitat) if habitat else ""),
    title: title,
    lede: summary
  }) %}
    {% if kills.length %}{{ tally({ value: kills | total, label: "slain by the company" }) }}{% endif %}
  {% endcall %}

  {% call prose({ dropcap: true }) %}{{ content | safe }}{% endcall %}

  {% if kills.length %}
  {% call section({ title: "Who struck them down", id: "kills-h" }) %}
    <ul class="plain-list">
      {%- for k in kills %}
      {% set who = collections.company | bySlug(k.by) %}
      <li>{{ k.count }} by {% if who %}<a href="{{ who.url }}">{{ who.data.title }}</a>{% else %}{{ k.by or "the company" }}{% endif %}, in <a href="{{ k.session.url }}">{{ k.session.data.title }}</a></li>
      {%- endfor %}
    </ul>
  {% endcall %}
  {% endif %}

  {% if seen.length %}
  {% call section({ title: "Encountered in", id: "seen-h" }) %}{{ sessionList(seen) }}{% endcall %}
  {% endif %}
</article>
