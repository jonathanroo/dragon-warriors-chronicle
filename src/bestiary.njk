---
layout: layouts/base.njk
title: Bestiary
permalink: /bestiary/
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/ledger/ledger.njk" import ledger %}
{{ pageHeader({ kicker: "Things that have tried to kill us", title: title }) }}
{% call ledger({ caption: "Creatures encountered", hideCaption: true, head: [{ text: "Creature" }, { text: "Kind" }, { text: "Slain", numeric: true }] }) %}
  {% for c in collections.bestiary %}
  <tr>
    <td><a href="{{ c.url }}">{{ c.data.title }}</a></td>
    <td>{{ c.data.kind }}</td>
    <td class="ledger__num">{{ collections.sessions | kills("creature", c.fileSlug) | total }}</td>
  </tr>
  {% endfor %}
{% endcall %}
