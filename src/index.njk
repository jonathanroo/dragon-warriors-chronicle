---
layout: layouts/base.njk
title: Home
---
{% from "components/hero/hero.njk" import hero %}
{% from "components/tally/tally.njk" import tallies %}
{% from "components/rule/rule.njk" import rule %}
{% from "components/feature/feature.njk" import feature %}
{% from "components/section/section.njk" import section %}
{% from "components/card/card.njk" import card, cardGrid %}
{% set latest = collections.sessions | last %}
{% set count = collections.sessions.length %}

{% call hero({
  kicker: "Here begins",
  title: "The Story So Far",
  lede: site.description
}) %}
  {{ tallies([
    { value: count, label: "entry" if count == 1 else "entries" },
    { value: collections.company | whereNot("status", "dead") | length, label: "still standing" },
    { value: collections.sessions | slainTotal, label: "foes slain" }
  ]) }}
{% endcall %}

{{ rule() }}

{% if latest %}
{{ feature({
  kicker: "The latest entry, the " + (latest.data.session | ordinal),
  title: latest.data.title,
  href: latest.url,
  lede: latest.data.summary,
  linkText: "Read the entry"
}) }}
{% endif %}

{% call section({ title: "The Company", id: "company-h", wide: true }) %}
  {% call cardGrid() %}
    {% for c in collections.company | whereNot("status", "dead") %}
    {{ card({ title: c.data.title, href: c.url, sub: c.data.profession, image: c.data.portrait }) }}
    {% endfor %}
  {% endcall %}
{% endcall %}
