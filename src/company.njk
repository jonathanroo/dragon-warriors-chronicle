---
layout: layouts/base.njk
title: The Company
permalink: /company/
---
{% from "components/page-header/page-header.njk" import pageHeader %}
{% from "components/section/section.njk" import section %}
{% from "components/card/card.njk" import card, cardGrid %}
{% set living = collections.company | whereNot("status", "dead") %}
{% set fallen = collections.company | where("status", "dead") %}
{{ pageHeader({ kicker: "Those who ride together", title: title }) }}

{% call cardGrid() %}
  {% for c in living %}
  {{ card({ title: c.data.title, href: c.url, sub: c.data.profession, body: c.data.epithet, foot: ("Played by " + c.data.player) if c.data.player }) }}
  {% endfor %}
{% endcall %}

{% if fallen.length %}
{% call section({ title: "The Fallen", id: "fallen-h", wide: true }) %}
  {% call cardGrid() %}
    {% for c in fallen %}
    {{ card({ title: c.data.title, href: c.url, sub: c.data.profession, body: c.data.epitaph, muted: true }) }}
    {% endfor %}
  {% endcall %}
{% endcall %}
{% endif %}
